{
  "name": "iraqi-data",
  "version": "0.3.0",
  "description": "Iraqi governorates and districts in Arabic, English and Kurdish, with search that handles spelling variations, Iraqi mobile number validation with carrier detection, and helpers for Arabic digits and dinar prices",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "tsx ./node_modules/mocha/bin/mocha \"./test/**/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "iraq",
    "iraqi",
    "governorates",
    "provinces",
    "districts",
    "kurdistan",
    "arabic",
    "kurdish",
    "address",
    "phone",
    "mobile",
    "phone-number",
    "asiacell",
    "zain",
    "korek",
    "currency",
    "iqd",
    "dinar",
    "arabic-numerals",
    "geography",
    "geolocation",
    "data",
    "typescript"
  ],
  "author": "Karam Al-Dulaimi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karam-fikre/iraqi-data.git"
  },
  "bugs": {
    "url": "https://github.com/karam-fikre/iraqi-data/issues"
  },
  "homepage": "https://github.com/karam-fikre/iraqi-data#readme",
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^26.6.5",
    "mocha": "^12.0.3",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  }
}
